{
  "format_version": 1,
  "cache_codec": "packed",
  "seed": 2027,
  "device": "cuda",
  "precision": "bf16",
  "paths": {
    "cache_dir": "data/processed/boards/strength_v1",
    "dataset_dir": "data/processed/strength_v2/seed2027",
    "output_dir": "outputs/v2_s8b"
  },
  "split": {
    "policy": "player_disjoint",
    "seen_holdout_fraction": 0.1
  },
  "questions": {
    "validation": 10000
  },
  "model": {
    "channels": 256,
    "blocks": 20,
    "hidden_size": 256,
    "bn_eps": 1e-05,
    "bn_momentum": 0.1
  },
  "loader": {
    "num_workers": 2,
    "prefetch_factor": 2,
    "pin_memory": true,
    "persistent_workers": true,
    "max_open_shards": 8,
    "d4": true
  },
  "optimizer": {
    "lr": 0.001,
    "weight_decay": 0.0001,
    "betas": [
      0.9,
      0.999
    ],
    "eps": 1e-08
  },
  "training": {
    "epochs": 1,
    "global_batch_size": 65536,
    "warmup_fraction": 0.05,
    "minimum_lr_ratio": 0.0,
    "gradient_clip_norm": 1.0,
    "checkpoint_seconds": 900,
    "max_runtime_seconds": null,
    "shutdown_margin_seconds": 180,
    "max_steps": null,
    "sync_batch_norm": true,
    "channels_last": false,
    "cudnn_benchmark": false,
    "deterministic": true,
    "allow_tf32": false,
    "evaluate_every_steps": 50
  },
  "evaluation": {
    "global_batch_size": 65536,
    "question_decoder": "score_rank"
  },
  "strength_version": 2,
  "monitoring": {
    "games_per_rank": 2500,
    "score_unit": "game",
    "decoder": "argmax"
  }
}
